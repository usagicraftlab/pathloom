{
  "name": "pathloom",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tauri dev",
    "test": "node --test tests/*.test.mjs",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "mac:dev": "tauri dev",
    "mac:build": "tauri build --bundles app,dmg",
    "mac:dmg": "tauri build --bundles dmg",
    "cad:setup": "node scripts/setup-cad-runtime.mjs",
    "test:cad-native": ".pathloom-runtime/python/bin/python -B -m unittest discover -s native -p 'test*.py'",
    "code:build": "node scripts/build-code-runtime.mjs",
    "test:browser": "npm run desktop:prepare && playwright test"
  },
  "devDependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.0.0",
    "esbuild": "^0.28.2",
    "quickjs-emscripten-core": "^0.32.0"
  },
  "engines": {
    "node": ">=20"
  }
}
