{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pathloom",
  "version": "0.1.0",
  "identifier": "com.usagicraftlab.pathloom",
  "build": {
    "beforeDevCommand": "node scripts/desktop-dev-server.mjs",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node scripts/prepare-desktop.mjs",
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pathloom",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
